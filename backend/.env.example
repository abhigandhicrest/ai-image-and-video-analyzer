# Copy this file to .env and fill in real values.
# Never commit .env. The React app must not receive these credentials.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=image_analyzer

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_UPLOAD_BYTES=5242880
MAX_VIDEO_BYTES=52428800
MAX_VIDEO_SECONDS=60
VIDEO_SAMPLE_FRAMES=6
MODERATION_REVIEW_THRESHOLD=50
MODERATION_RESTRICTED_THRESHOLD=80
LABEL_MIN_CONFIDENCE=50
